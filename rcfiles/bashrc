cat ~/.bash_profile 
EDITOR=vim
PS1="\[\033[34m\]\h:\W \[\033[35m\]\$(parse_git_branch)\[\033[00m\]\$(git config user.initials)$\[\033[00m\] "
SUDO_PS1='\[\e[0;31m\]\u\[\e[m\] \[\e[1;34m\]\w\[\e[m\] \[\e[0;31m\]\$ \[\e[0m\]'

HISTCONTROL=ignoredups;
shopt -s histappend;
PROMPT_COMMAND='echo -ne "\033]0;${USER}: ${PWD}\007"'

### FUNCTIONS

# This function is used in several aliases below.
function parse_git_branch() { git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/\1 /'; }
export -f parse_git_branch

test -f $HOME/.aliases && source .aliases

export EDITOR HISTCONTROL PROMPT_COMMAND PS1 SUDO_PS1

ps aux | grep -q 'ssh-agent' || eval "$(ssh-agent -s)"

